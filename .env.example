# Copy to .env and fill in from Supabase → Project Settings → API.
# The anon/publishable key is safe to ship in the app; RLS protects the data.
# NEVER put the service-role key in any VITE_* var (everything VITE_* ships in the bundle).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Cloudflare Turnstile site key (the public one) for the sign-in and sign-up forms.
# Leave empty for local development: no widget is shown and the local stack asks for no captcha.
# The secret key goes in Supabase → Authentication → Attack Protection, never here.
VITE_TURNSTILE_SITE_KEY=
